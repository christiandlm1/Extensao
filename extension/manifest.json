{
  "manifest_version": 3,
  "name": "Downloader — IG, TikTok & X",
  "version": "2.0.0",
  "description": "Baixa vídeos direto para a pasta Downloads. Hover no vídeo → Baixar. Bot Shopee mantido.",
  "permissions": ["downloads", "storage", "unlimitedStorage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.ttwstatic.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.twimg.com/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["shared.js", "strip.js", "remux.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["shared.js", "strip.js", "remux.js", "content-tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["shared.js", "strip.js", "remux.js", "content-x.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Downloader — Baixar direto",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["tap.js", "shared.js"],
      "matches": ["https://www.instagram.com/*", "https://www.tiktok.com/*", "https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}